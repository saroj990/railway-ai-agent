# ---------------------------------------------------------------------------
# LLM provider: "ollama" (default), "openai" (any OpenAI-compatible endpoint),
# or "none" (no LLM: deterministic intent router, useful for offline demos).
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama

# Ollama. Pull a tool-capable model first, e.g. `ollama pull llama3.1`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# OpenAI-compatible endpoint (only used when LLM_PROVIDER=openai).
# Works with OpenAI, vLLM, LM Studio, OpenRouter, etc.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Request behaviour
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.1
AGENT_MAX_TOOL_ROUNDS=6

# Railway data
RAILWAY_DB_PATH=data/railways.db
